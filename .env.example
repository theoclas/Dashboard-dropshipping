# Credenciales de MySQL para docker-compose.yml (raíz del repo).
#
# OPCIONAL: sin este archivo, docker-compose usa los valores por defecto que ya
# estaban en uso. Sirve para rotar credenciales sin editar docker-compose.yml.
#
# Ojo: cambiar estas variables NO cambia la contraseña de una base ya creada.
# MySQL solo las aplica al inicializar un directorio de datos vacío. Para rotar
# sobre una base existente hay que hacer ALTER USER — ver §4 de
# docs/07-seguridad-infra.md.
#
# Generar contraseñas fuertes:
#   openssl rand -base64 24
#
# Deben coincidir con DATABASE_URL en back/.env

MYSQL_ROOT_PASSWORD=cambiar-por-una-contrasena-fuerte
MYSQL_DATABASE=fersua_dashboard
MYSQL_USER=fersua
MYSQL_PASSWORD=cambiar-por-otra-contrasena-fuerte
